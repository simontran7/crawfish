const THRESHOLD: I32 = 10;
const ENABLED: Bool = true;

func abs(x: I32) -> I32 {
    if x < 0 {
        return -x;
    }
    x
}

func clamp(x: I32, lo: I32, hi: I32) -> I32 {
    let mut r: I32 = x;
    if r < lo {
        r = lo;
    } else if r > hi {
        r = hi;
    }
    r
}

func fib(n: I32) -> I32 {
    if n < 2 {
        return n;
    }
    fib(n - 1) + fib(n - 2)
}

func classify(a: I32, b: I32, c: I32) -> I32 {
    let mut score: I32 = 0;

    if a < b and b < c {
        score = score + 3;
    } else if a == b or b == c {
        score = score + 1;
    } else {
        score = score - 1;
    }

    let d: I32 = if a > THRESHOLD { abs(a) } else { clamp(a, 0, THRESHOLD) };
    score = score + d;

    if ENABLED and not (score < 0) {
        score = score * 2;
    }

    if score < 0 {
        return 0;
    }

    score
}

func deep(x: I32) -> I32 {
    let mut y: I32 = x;
    if x < 1 {
        y = 1;
    } else if x < 2 {
        y = 2;
    } else if x < 3 {
        y = 3;
    } else if x < 4 {
        y = 4;
    } else {
        y = fib(x);
    }

    let mut acc: I32 = 0;
    if y > 0 and (y < THRESHOLD or ENABLED) {
        acc = acc + abs(y);
        if not (y == THRESHOLD) {
            acc = acc + clamp(y, 1, 5);
        }
    }
    acc + y
}
