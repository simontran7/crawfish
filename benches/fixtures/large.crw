const ZERO: i32 = 0;
const ONE: i32 = 1;
const TWO: i32 = 2;
const THREE: i32 = 3;
const NEG_ONE: i32 = -1;
const MAX: i32 = 2147483647;
const MIN_VAL: i32 = -2147483647;
const HUNDRED: i32 = 100;
const THOUSAND: i32 = 1000;
const TRUE: bool = true;
const FALSE: bool = false;

func add(x: i32, y: i32) -> i32 {
    x + y
}

func sub(x: i32, y: i32) -> i32 {
    x - y
}

func mul(x: i32, y: i32) -> i32 {
    x * y
}

func div(x: i32, y: i32) -> i32 {
    x / y
}

func negate(x: i32) -> i32 {
    -x
}

func is_zero(x: i32) -> bool {
    x == 0
}

func is_positive(x: i32) -> bool {
    x > 0
}

func is_negative(x: i32) -> bool {
    x < 0
}

func is_equal(x: i32, y: i32) -> bool {
    x == y
}

func is_not_equal(x: i32, y: i32) -> bool {
    x != y
}

func is_less(x: i32, y: i32) -> bool {
    x < y
}

func is_greater(x: i32, y: i32) -> bool {
    x > y
}

func is_less_or_equal(x: i32, y: i32) -> bool {
    x < y or x == y
}

func is_greater_or_equal(x: i32, y: i32) -> bool {
    x > y or x == y
}

func abs(x: i32) -> i32 {
    if x > 0 {
        x
    } else {
        -x
    }
}

func max(x: i32, y: i32) -> i32 {
    if x > y {
        x
    } else {
        y
    }
}

func min(x: i32, y: i32) -> i32 {
    if x < y {
        x
    } else {
        y
    }
}

func clamp(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        lo
    } else {
        if x > hi {
            hi
        } else {
            x
        }
    }
}

func sign(x: i32) -> i32 {
    if x > 0 {
        1
    } else {
        if x < 0 {
            -1
        } else {
            0
        }
    }
}

func both(a: bool, b: bool) -> bool {
    a and b
}

func either(a: bool, b: bool) -> bool {
    a or b
}

func flip(f: bool) -> bool {
    not f
}

func implies(a: bool, b: bool) -> bool {
    not a or b
}

func xor(a: bool, b: bool) -> bool {
    not a and b or a and not b
}

func sum_three(a: i32, b: i32, c: i32) -> i32 {
    add(add(a, b), c)
}

func sum_four(a: i32, b: i32, c: i32, d: i32) -> i32 {
    add(sum_three(a, b, c), d)
}

func sum_five(a: i32, b: i32, c: i32, d: i32, e: i32) -> i32 {
    add(sum_four(a, b, c, d), e)
}

func in_range(x: i32, lo: i32, hi: i32) -> bool {
    x > lo and x < hi
}

func in_range_inclusive(x: i32, lo: i32, hi: i32) -> bool {
    x > lo and x < hi or x == lo or x == hi
}

func scale(x: i32, factor: i32) -> i32 {
    mul(x, factor)
}

func scale_and_shift(x: i32, factor: i32, offset: i32) -> i32 {
    add(mul(x, factor), offset)
}

func diff(x: i32, y: i32) -> i32 {
    abs(sub(x, y))
}

func midpoint(x: i32, y: i32) -> i32 {
    div(add(x, y), 2)
}

func square(x: i32) -> i32 {
    mul(x, x)
}

func cube(x: i32) -> i32 {
    mul(mul(x, x), x)
}

func double(x: i32) -> i32 {
    add(x, x)
}

func triple(x: i32) -> i32 {
    add(add(x, x), x)
}

func quadruple(x: i32) -> i32 {
    add(double(x), double(x))
}

func apply_twice(x: i32, delta: i32) -> i32 {
    let a: i32 = add(x, delta);
    let b: i32 = add(a, delta);
    b
}

func apply_three_times(x: i32, delta: i32) -> i32 {
    let a: i32 = add(x, delta);
    let b: i32 = add(a, delta);
    let c: i32 = add(b, delta);
    c
}

func apply_four_times(x: i32, delta: i32) -> i32 {
    let a: i32 = apply_twice(x, delta);
    let b: i32 = apply_twice(a, delta);
    b
}

func swap_diff(x: i32, y: i32) -> i32 {
    let tmp: i32 = x;
    sub(y, tmp)
}

func conditional_negate(x: i32, flag: bool) -> i32 {
    if flag {
        negate(x)
    } else {
        x
    }
}

func conditional_double(x: i32, flag: bool) -> i32 {
    if flag {
        double(x)
    } else {
        x
    }
}

func conditional_add(x: i32, y: i32, flag: bool) -> i32 {
    if flag {
        add(x, y)
    } else {
        x
    }
}

func conditional_clamp(x: i32, lo: i32, hi: i32, flag: bool) -> i32 {
    if flag {
        clamp(x, lo, hi)
    } else {
        x
    }
}

func max_of_three(a: i32, b: i32, c: i32) -> i32 {
    max(max(a, b), c)
}

func min_of_three(a: i32, b: i32, c: i32) -> i32 {
    min(min(a, b), c)
}

func max_of_four(a: i32, b: i32, c: i32, d: i32) -> i32 {
    max(max_of_three(a, b, c), d)
}

func min_of_four(a: i32, b: i32, c: i32, d: i32) -> i32 {
    min(min_of_three(a, b, c), d)
}

func all_positive(a: i32, b: i32, c: i32) -> bool {
    is_positive(a) and is_positive(b) and is_positive(c)
}

func all_negative(a: i32, b: i32, c: i32) -> bool {
    is_negative(a) and is_negative(b) and is_negative(c)
}

func any_zero(a: i32, b: i32, c: i32) -> bool {
    is_zero(a) or is_zero(b) or is_zero(c)
}

func any_positive(a: i32, b: i32, c: i32) -> bool {
    is_positive(a) or is_positive(b) or is_positive(c)
}

func saturating_add(x: i32, y: i32, limit: i32) -> i32 {
    let result: i32 = add(x, y);
    clamp(result, negate(limit), limit)
}

func saturating_sub(x: i32, y: i32, limit: i32) -> i32 {
    let result: i32 = sub(x, y);
    clamp(result, negate(limit), limit)
}

func lerp(a: i32, b: i32, t: i32) -> i32 {
    let range: i32 = sub(b, a);
    let scaled: i32 = mul(range, t);
    add(a, scaled)
}

func manhattan(x1: i32, y1: i32, x2: i32, y2: i32) -> i32 {
    add(diff(x1, x2), diff(y1, y2))
}

func dot(x1: i32, y1: i32, x2: i32, y2: i32) -> i32 {
    add(mul(x1, x2), mul(y1, y2))
}

func between(x: i32, a: i32, b: i32) -> bool {
    let lo: i32 = min(a, b);
    let hi: i32 = max(a, b);
    in_range(x, lo, hi)
}

func select(flag: bool, a: i32, b: i32) -> i32 {
    if flag {
        a
    } else {
        b
    }
}

func count_true(a: bool, b: bool, c: bool) -> i32 {
    let x: i32 = if a { 1 } else { 0 };
    let y: i32 = if b { 1 } else { 0 };
    let z: i32 = if c { 1 } else { 0 };
    sum_three(x, y, z)
}

func majority(a: bool, b: bool, c: bool) -> bool {
    count_true(a, b, c) > 1
}

func weighted_sum(a: i32, wa: i32, b: i32, wb: i32) -> i32 {
    add(mul(a, wa), mul(b, wb))
}

func scale_to_range(x: i32, in_lo: i32, in_hi: i32, out_lo: i32, out_hi: i32) -> i32 {
    let in_range_size: i32 = sub(in_hi, in_lo);
    let out_range_size: i32 = sub(out_hi, out_lo);
    let shifted: i32 = sub(x, in_lo);
    let scaled: i32 = mul(shifted, out_range_size);
    add(div(scaled, in_range_size), out_lo)
}

func triangle(n: i32) -> i32 {
    div(mul(n, add(n, 1)), 2)
}

func is_even(x: i32) -> bool {
    let half: i32 = div(x, 2);
    is_equal(mul(half, 2), x)
}

func is_odd(x: i32) -> bool {
    flip(is_even(x))
}

func safe_div(x: i32, y: i32, fallback: i32) -> i32 {
    if is_zero(y) {
        fallback
    } else {
        div(x, y)
    }
}

func normalize_sign(x: i32, positive: bool) -> i32 {
    let s: i32 = sign(x);
    let target: i32 = if positive { 1 } else { -1 };
    if is_equal(s, target) {
        x
    } else {
        negate(x)
    }
}
